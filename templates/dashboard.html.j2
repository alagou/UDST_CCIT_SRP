<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CCIT Student Research Program</title>
  <style>
    :root {
      --navy: #0055b8;
      --ink: #1d1e1c;
      --muted: #5c6568;
      --line: #d9d8d6;
      --paper: #efefee;
      --card: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: var(--ink);
      background: var(--paper);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 22px;
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 16px 28px;
    }
    .brand img { height: 78px; width: auto; }
    .brand .uni {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      color: var(--ink);
      line-height: 1.3;
    }
    .brand .college {
      margin: 4px 0 0;
      font-size: 16px;
      font-weight: 700;
      color: var(--ink);
      line-height: 1.3;
    }
    header {
      background: var(--navy);
      color: #fff;
      padding: 20px 28px 16px;
    }
    .tabs {
      display: flex;
      gap: 4px;
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 0 20px;
      position: sticky;
      top: 0;
      z-index: 3;
    }
    .tabs button {
      font: inherit;
      font-size: 14px;
      font-weight: 700;
      color: var(--muted);
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      padding: 14px 16px 11px;
      cursor: pointer;
    }
    .tabs button[aria-selected="true"] {
      color: var(--navy);
      border-bottom-color: var(--navy);
    }
    .panel[hidden] { display: none; }
    .page {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 22px 24px;
      max-width: 820px;
    }
    .page h2 { margin: 0 0 12px; color: var(--navy); font-size: 20px; }
    .page p { margin: 0 0 14px; font-size: 15px; line-height: 1.65; }
    .page p:last-child { margin-bottom: 0; }
    .contact { margin: 0; }
    .contact div { margin: 0 0 14px; }
    .contact dt { font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: 0.03em; text-transform: uppercase; }
    .contact dd { margin: 2px 0 0; font-size: 16px; }
    .contact dd + dd { margin-top: 6px; }
    .contact a { color: var(--navy); }
    header h1 { margin: 0 0 4px; font-size: 22px; font-weight: 650; }
    header p { margin: 0; color: #d6e6f7; font-size: 14px; }
    main { max-width: 1180px; margin: 0 auto; padding: 20px 20px 48px; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }
    .stat {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .stat b { display: block; font-size: 22px; color: var(--navy); }
    .stat span { color: var(--muted); font-size: 12px; }
    .controls {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px 12px;
      margin-bottom: 12px;
      position: sticky;
      top: 49px;
      z-index: 2;
    }
    .controls-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .controls-fields {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }
    .controls.is-min .controls-fields { display: none; }
    #toggle-filters {
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      color: var(--navy);
      background: #fff;
      border: 1px solid var(--navy);
      border-radius: 999px;
      padding: 4px 10px;
      cursor: pointer;
    }
    #toggle-filters:hover { background: var(--navy); color: #fff; }
    label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
    input, select {
      font: inherit;
      color: var(--ink);
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 8px 10px;
      background: #fff;
    }
    .shown { margin-left: auto; font-size: 13px; color: var(--navy); }
    .focus-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 0;
    }
    .focus-bar span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .focus-bar[hidden] { display: none; }
    .focus-bar button, .details-btn {
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      color: var(--navy);
      background: #fff;
      border: 1px solid var(--navy);
      border-radius: 999px;
      padding: 4px 10px;
      cursor: pointer;
    }
    .focus-bar button:hover, .details-btn:hover { background: var(--navy); color: #fff; }
    .details-btn { display: none; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; }
    body.view-compact .cards { grid-template-columns: 1fr; }
    body.view-compact .card { padding: 10px 12px; }
    body.view-compact .details { display: none; }
    body.view-compact .details-btn { display: inline-block; }
    body.view-compact .card h2 { margin-bottom: 4px; }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px 14px 12px;
      break-inside: avoid;
    }
    .card.attention { box-shadow: inset 4px 0 0 #d97706; }
    .pid { margin: 0; color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: 0.03em; }
    .card h2 { margin: 2px 0 8px; font-size: 16px; line-height: 1.3; color: var(--navy); overflow-wrap: anywhere; }
    .meta { margin: 0 0 4px; font-size: 13px; line-height: 1.4; }
    .badge {
      display: inline-block;
      margin: 8px 8px 8px 0;
      padding: 4px 8px;
      border-radius: 999px;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
    }
    .members { margin: 6px 0 8px; padding-left: 18px; font-size: 13px; }
    .members li { margin: 2px 0; }
    .empty-members { margin: 6px 0 8px; font-size: 13px; }
    .note { color: var(--muted); font-size: 12px; margin: 6px 0 0; }
    .prose { white-space: pre-wrap; margin: 0 0 8px; font-size: 13px; line-height: 1.45; }
    .none {
      display: none;
      background: var(--card);
      border: 1px dashed #cbd5e1;
      border-radius: 10px;
      padding: 18px;
      color: var(--muted);
    }
    @media (max-width: 640px) {
      .brand { flex-direction: column; align-items: flex-start; gap: 10px; }
      .brand img { height: 72px; }
    }
    @media print {
      .tabs, .controls, .focus-bar, .details-btn, #panel-about, #panel-contact { display: none; }
      #panel-status { display: block; }
      header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <div class="brand">
    <img src="{{ logo_src }}" alt="University of Doha for Science and Technology">
    <div>
      <p class="uni">University of Doha for Science and Technology</p>
      <p class="college">College of Computing and Information Technology</p>
    </div>
  </div>
  <header>
    <h1>CCIT Student Research Program</h1>
    <p>2026/2027 · Generated {{ generated_at }}</p>
  </header>
  <nav class="tabs" aria-label="Sections">
    <button type="button" data-tab="panel-status" aria-selected="true">Project Status</button>
    <button type="button" data-tab="panel-about" aria-selected="false">About SRP</button>
    <button type="button" data-tab="panel-contact" aria-selected="false">Contact Us</button>
  </nav>
  <main>
    <div class="panel" id="panel-status">
    <section class="stats" aria-label="Summary">
      <div class="stat"><b>{{ summary.total_projects }}</b><span>Total Projects</span></div>
      <div class="stat"><b>{{ summary.total_students_assigned }}</b><span>Total Students Assigned</span></div>
      <div class="stat"><b>{{ summary.projects_recruiting }}</b><span>Projects Recruiting</span></div>
      <div class="stat"><b>{{ summary.projects_full }}</b><span>Projects Full</span></div>
      <div class="stat"><b>{{ summary.projects_with_no_students }}</b><span>Projects With No Students</span></div>
      <div class="stat"><b>{{ summary.total_available_positions }}</b><span>Total Available Positions</span></div>
    </section>

    <section class="controls" id="controls">
      <div class="controls-bar">
        <button type="button" id="toggle-filters" aria-expanded="true" aria-controls="controls-fields">Minimize</button>
        <div class="focus-bar" id="focus-bar" hidden>
          <button type="button" id="back-to-list">All projects</button>
          <span id="focus-label"></span>
        </div>
        <div class="shown" id="shown-count"></div>
      </div>
      <div class="controls-fields" id="controls-fields">
      <label>Project title
        <input id="q-title" type="search" placeholder="Search titles">
      </label>
      <label>Supervisor
        <input id="q-supervisor" type="search" placeholder="Search supervisor name">
      </label>
      <label>Student
        <input id="q-student" type="search" placeholder="Search student name">
      </label>
      <label>Status
        <select id="f-status">
          <option value="">All statuses</option>
          <option value="recruiting">Recruiting</option>
          <option value="full">Full</option>
          <option value="empty">Empty</option>
          <option value="closed">Closed</option>
          <option value="action">Action Needed</option>
        </select>
      </label>
      <label>Preferred program
        <select id="f-program">
          <option value="">All programs</option>
          {% for program in programs %}
          <option value="{{ program|lower }}">{{ program }}</option>
          {% endfor %}
        </select>
      </label>
      <label>View
        <select id="f-view">
          <option value="full">Full</option>
          <option value="compact">Compact</option>
        </select>
      </label>
      <label>Project
        <select id="f-project">
          <option value="">All projects</option>
          {% for card in cards %}
          <option value="{{ card.project_id }}">{{ card.project_id }} — {{ card.title }}</option>
          {% endfor %}
        </select>
      </label>
      </div>
    </section>

    <p class="none" id="no-matches">No projects match these filters.</p>
    <section class="cards" id="cards">
      {% for card in cards %}
      <article class="card"
        data-id="{{ card.project_id }}"
        data-title="{{ card.title|lower }}"
        data-supervisor="{{ (card.supervisor_name ~ ' ' ~ card.supervisor_email)|lower }}"
        data-students="{{ card.student_search }}"
        data-bucket="{{ card.bucket }}"
        data-empty="{{ 'true' if card.is_empty else 'false' }}"
        data-programs="{{ card.programs_key }}">
        <p class="pid">{{ card.project_id }}</p>
        <h2>{{ card.title }}</h2>
        <p class="meta"><strong>Supervisor:</strong> {{ card.supervisor_name }} ({{ card.supervisor_email }})</p>
        <span class="badge" style="background: {{ card.status_color }}">{{ card.status_label }}</span>
        <button type="button" class="details-btn" data-id="{{ card.project_id }}">Details</button>
        <p class="meta"><strong>Student Capacity:</strong> {{ card.assigned }} / {{ card.maximum_display }}
          · <strong>Available Positions:</strong> {{ card.available_display }}</p>
        <div class="details">
        {% if card.co_supervisor %}
        <p class="meta"><strong>Co-Supervisor:</strong> {{ card.co_supervisor }}</p>
        {% endif %}
        <p class="meta"><strong>Current Members</strong></p>
        {% if card.members %}
        <ul class="members">
          {% for member in card.members %}
          <li>{{ member.name }} — {{ member.student_id }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty-members">No students assigned yet</p>
        {% endif %}
        <p class="meta"><strong>Preferred Program / Year:</strong> {{ card.program_year }}</p>
        {% if card.skills %}
        <p class="meta"><strong>Required Skills</strong></p>
        <p class="prose">{{ card.skills }}</p>
        {% endif %}
        {% if card.description %}
        <p class="meta"><strong>Project Description</strong></p>
        <p class="prose">{{ card.description }}</p>
        {% endif %}
        {% if card.objectives %}
        <p class="meta"><strong>Research Objectives &amp; Expected Outcomes</strong></p>
        <p class="prose">{{ card.objectives }}</p>
        {% endif %}
        {% if card.comments %}
        <p class="meta"><strong>Additional Comments</strong></p>
        <p class="prose">{{ card.comments }}</p>
        {% endif %}
        </div>
      </article>
      {% endfor %}
    </section>
    </div>

    <div class="panel" id="panel-about" hidden>
      <article class="page">
        <h2>About SRP</h2>
        <p>The CCIT Student Research Program (SRP) is an initiative that aims to formalize and promote voluntary research collaborations between students and faculty members. The program provides students with opportunities to engage in impactful research beyond their regular coursework, capstone projects, and funded research activities, while enabling faculty members to mentor motivated students in areas aligned with their research expertise and interests.</p>
        <p>Following the launch of the program in May 2025 and the successful 1st SRP Showcase held in June 2026, we are pleased to continue building on this momentum and welcome new faculty and student participants for the 2026/2027 SRP cycle.</p>
      </article>
    </div>

    <div class="panel" id="panel-contact" hidden>
      <article class="page">
        <h2>Contact Us</h2>
        <dl class="contact">
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></dd>
            <dd><a href="mailto:asif.khan@udst.edu.qa">asif.khan@udst.edu.qa</a></dd>
          </div>
          <div>
            <dt>College</dt>
            <dd>College of Computing and Information Technology</dd>
          </div>
          <div>
            <dt>University</dt>
            <dd>University of Doha for Science and Technology</dd>
          </div>
          <div>
            <dt>Campus</dt>
            <dd>Al Tarafa, Jelaiah Street, Duhail North, P.O. Box 24449, Doha, Qatar</dd>
          </div>
        </dl>
      </article>
    </div>
  </main>
  <script>
    (function () {
      var titleInput = document.getElementById("q-title");
      var supervisorInput = document.getElementById("q-supervisor");
      var studentInput = document.getElementById("q-student");
      var statusSelect = document.getElementById("f-status");
      var programSelect = document.getElementById("f-program");
      var viewSelect = document.getElementById("f-view");
      var projectSelect = document.getElementById("f-project");
      var shown = document.getElementById("shown-count");
      var empty = document.getElementById("no-matches");
      var focusBar = document.getElementById("focus-bar");
      var focusLabel = document.getElementById("focus-label");
      var cards = Array.prototype.slice.call(document.querySelectorAll(".card"));

      function matches(card) {
        var title = titleInput.value.trim().toLowerCase();
        var supervisor = supervisorInput.value.trim().toLowerCase();
        var student = studentInput.value.trim().toLowerCase();
        var status = statusSelect.value;
        var program = programSelect.value;
        var project = projectSelect.value;
        if (project && card.dataset.id !== project) return false;
        if (title && card.dataset.title.indexOf(title) === -1) return false;
        if (supervisor && card.dataset.supervisor.indexOf(supervisor) === -1) return false;
        if (student && card.dataset.students.indexOf(student) === -1) return false;
        if (status === "empty") {
          if (card.dataset.empty !== "true") return false;
        } else if (status && card.dataset.bucket !== status) {
          return false;
        }
        if (program) {
          var list = (card.dataset.programs || "").split("|").filter(Boolean);
          if (list.indexOf(program) === -1 && list.indexOf("any") === -1) return false;
        }
        return true;
      }

      function applyFilters() {
        var project = projectSelect.value;
        var compact = viewSelect.value === "compact" && !project;
        document.body.classList.toggle("view-compact", compact);
        var count = 0;
        var focusTitle = "";
        cards.forEach(function (card) {
          var ok = matches(card);
          card.style.display = ok ? "" : "none";
          if (ok) {
            count += 1;
            if (project) focusTitle = card.dataset.id + " — " + card.querySelector("h2").textContent;
          }
        });
        focusLabel.textContent = focusTitle;
        focusBar.hidden = !project;
        shown.textContent = count + " of " + cards.length + " shown";
        empty.style.display = count === 0 ? "block" : "none";
      }

      function openProject(projectId) {
        projectSelect.value = projectId;
        applyFilters();
        var card = document.querySelector('.card[data-id="' + projectId + '"]');
        if (card) card.scrollIntoView({ block: "nearest" });
      }

      [titleInput, supervisorInput, studentInput].forEach(function (node) {
        node.addEventListener("input", applyFilters);
      });
      statusSelect.addEventListener("change", applyFilters);
      programSelect.addEventListener("change", applyFilters);
      viewSelect.addEventListener("change", applyFilters);
      projectSelect.addEventListener("change", applyFilters);
      document.getElementById("back-to-list").addEventListener("click", function () {
        projectSelect.value = "";
        applyFilters();
      });
      document.getElementById("cards").addEventListener("click", function (event) {
        var button = event.target.closest(".details-btn");
        if (!button) return;
        openProject(button.getAttribute("data-id"));
      });
      applyFilters();

      var controls = document.getElementById("controls");
      var toggleFilters = document.getElementById("toggle-filters");
      toggleFilters.addEventListener("click", function () {
        var minimized = controls.classList.toggle("is-min");
        toggleFilters.setAttribute("aria-expanded", minimized ? "false" : "true");
        toggleFilters.textContent = minimized ? "Show" : "Minimize";
      });

      document.querySelectorAll(".tabs button").forEach(function (button) {
        button.addEventListener("click", function () {
          var id = button.getAttribute("data-tab");
          document.querySelectorAll(".tabs button").forEach(function (item) {
            item.setAttribute("aria-selected", item === button ? "true" : "false");
          });
          document.querySelectorAll(".panel").forEach(function (panel) {
            panel.hidden = panel.id !== id;
          });
        });
      });
    }());
  </script>
</body>
</html>
